TEAM_ID=

PRODUCT_NAME=Mishti
PRODUCT_BUNDLE_IDENTIFIER=com.abrarshakhi.mishti.Mishti$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

SWIFT_OBJC_BRIDGING_HEADER=iosApp/iosApp-Bridging-Header.h
HEADER_SEARCH_PATHS=$(inherited) "${SRCROOT}/native" "${SRCROOT}/../core/llm/native/common" "${SRCROOT}/../core/llm/native/llama.cpp/include" "${SRCROOT}/../core/llm/native/llama.cpp/ggml/include"

LIBRARY_SEARCH_PATHS=$(inherited) "$(DERIVED_FILE_DIR)/llama-install/lib"
OTHER_LDFLAGS=$(inherited) -lmishti_llama_ios -lllama -lggml -lggml-cpu -lggml-base -framework Accelerate -lc++
